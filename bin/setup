#!/usr/bin/env bash
# Build eightsleep from this checkout and install it into ~/.local/bin, with
# eightctl, its former name, as a link to the same binary.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

command -v go >/dev/null 2>&1 || { echo "error: go toolchain not found" >&2; exit 1; }

if version="$(git describe --tags --match 'v[0-9]*' --exact-match 2>/dev/null)"; then
  :
elif sha="$(git rev-parse --short HEAD 2>/dev/null)"; then
  version="dev+$sha"
else
  version="dev"
fi
prefix="${PREFIX:-$HOME/.local/bin}"
mkdir -p "$prefix"

for name in eightsleep eightctl; do
  if [ -e "$prefix/$name" ] && [ ! -f "$prefix/$name" ] && [ ! -L "$prefix/$name" ]; then
    echo "error: $prefix/$name exists and is not a regular file; refusing to overwrite" >&2
    exit 1
  fi
done

target="$prefix/eightsleep"
GOWORK=off go build -trimpath -ldflags "-s -w -X main.version=${version}" -o "$target" ./cmd/eightsleep
ln -sf eightsleep "$prefix/eightctl"

echo "installed: $target ($("$target" --version 2>&1 | head -1)), $prefix/eightctl -> eightsleep"
case ":$PATH:" in
  *":$prefix:"*) ;;
  *) echo "note: $prefix is not on PATH" >&2 ;;
esac
