{
  "program": "eightsleepctl",
  "args": [
    "alarm",
    "active"
  ],
  "new_args": [
    "alarm",
    "active",
    "--json"
  ],
  "exit": 0,
  "stdout_json": {
    "alarms": [
      {
        "daysOfWeek": [
          1,
          2,
          3,
          4,
          5
        ],
        "enabled": true,
        "id": "a1",
        "sound": "chime",
        "time": "07:00",
        "vibration": {
          "enabled": true,
          "pattern": "rise",
          "powerLevel": 50
        }
      }
    ]
  },
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "app-api",
      "path": "/v1/users/u1/alarms/active"
    }
  ]
}
