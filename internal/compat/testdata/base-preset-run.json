{
  "program": "eightctl",
  "args": [
    "base",
    "preset-run",
    "--name",
    "flat"
  ],
  "exit": 0,
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/me"
    },
    {
      "method": "POST",
      "host": "client-api",
      "path": "/v1/users/u1/base/presets"
    }
  ]
}
