{
  "program": "eightctl",
  "args": [
    "away",
    "on",
    "--both",
    "--side",
    "left"
  ],
  "exit": 1,
  "error": "--both conflicts with --side/--target-user-id",
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/me"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/devices/d1",
      "query": "filter=leftUserId,rightUserId,awaySides"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/u1"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/u2"
    }
  ]
}
