{
  "program": "eightctl",
  "args": [
    "status",
    "--side",
    "left"
  ],
  "exit": 1,
  "error": "api GET \u003cfake\u003e/app-api/v1/users/u1/temperature: status 500: {\"error\":\"fixture 500\"}",
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/me"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/devices/d1",
      "query": "filter=leftUserId,rightUserId,awaySides"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/u1"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/u2"
    },
    {
      "method": "GET",
      "host": "app-api",
      "path": "/v1/users/u1/temperature"
    }
  ]
}
