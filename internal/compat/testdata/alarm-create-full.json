{
  "program": "eightctl",
  "args": [
    "alarm",
    "create",
    "--time",
    "06:00",
    "--days",
    "0",
    "--disabled",
    "--no-vibration",
    "--sound",
    "chime"
  ],
  "exit": 0,
  "stdout_text": "created alarm a3\n",
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/me"
    },
    {
      "method": "POST",
      "host": "client-api",
      "path": "/v1/users/u1/alarms"
    }
  ],
  "writes": [
    {
      "method": "POST",
      "host": "client-api",
      "path": "/v1/users/u1/alarms",
      "body": {
        "daysOfWeek": [
          0
        ],
        "enabled": false,
        "id": "",
        "sound": "chime",
        "time": "06:00",
        "vibration": false
      }
    }
  ]
}
