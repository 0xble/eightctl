{
  "program": "eightctl",
  "args": [
    "status"
  ],
  "exit": 0,
  "stdout_text": "side  name          user_id  mode   level\nsolo  Ada Lovelace  u1       smart  -20\n",
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/me"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/devices/d1",
      "query": "filter=leftUserId,rightUserId,awaySides"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/u1"
    },
    {
      "method": "GET",
      "host": "app-api",
      "path": "/v1/users/u1/temperature"
    }
  ]
}
