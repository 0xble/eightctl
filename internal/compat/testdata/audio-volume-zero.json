{
  "program": "eightctl",
  "args": [
    "audio",
    "volume",
    "--level",
    "0"
  ],
  "exit": 0,
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/me"
    },
    {
      "method": "POST",
      "host": "client-api",
      "path": "/v1/users/u1/audio/player/volume"
    }
  ],
  "writes": [
    {
      "method": "POST",
      "host": "client-api",
      "path": "/v1/users/u1/audio/player/volume",
      "body": {
        "level": 0
      }
    }
  ]
}
