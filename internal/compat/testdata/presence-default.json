{
  "program": "eightctl",
  "args": [
    "presence"
  ],
  "exit": 0,
  "stdout_text": "present\ntrue\n",
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/me"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/u1/trends",
      "query": "from=\u003cyesterday\u003e\u0026include-all-sessions=true\u0026include-main=false\u0026model-version=v2\u0026to=\u003ctoday\u003e\u0026tz=UTC"
    }
  ]
}
