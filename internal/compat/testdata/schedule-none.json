{
  "program": "eightctl",
  "args": [
    "schedule",
    "list"
  ],
  "exit": 0,
  "stdout_text": "no Autopilot schedule configured for this user\n",
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/me"
    },
    {
      "method": "GET",
      "host": "app-api",
      "path": "/v1/users/u1/temperature"
    }
  ]
}
