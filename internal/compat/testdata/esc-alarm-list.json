{
  "program": "eightsleepctl",
  "args": [
    "alarm",
    "list"
  ],
  "new_args": [
    "alarm",
    "list",
    "--json"
  ],
  "exit": 0,
  "stdout_json": {
    "alarms": [
      {
        "daysOfWeek": [
          1,
          2,
          3,
          4,
          5
        ],
        "enabled": true,
        "id": "a1",
        "sound": "chime",
        "time": "07:00",
        "vibration": {
          "enabled": true,
          "pattern": "rise",
          "powerLevel": 50
        }
      },
      {
        "daysOfWeek": [
          0,
          6
        ],
        "enabled": false,
        "id": "a2",
        "time": "09:30",
        "vibration": false
      }
    ]
  },
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "app-api",
      "path": "/v1/users/u1/alarms"
    }
  ],
  "change": "rows {id,time,enabled,days,vibration,sound} instead of the raw alarm objects"
}
