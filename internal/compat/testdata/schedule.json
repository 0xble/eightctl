{
  "program": "eightctl",
  "args": [
    "schedule",
    "list",
    "--output",
    "json"
  ],
  "exit": 0,
  "stdout_json": [
    {
      "smart": {
        "bedTimeLevel": -10,
        "finalSleepLevel": 0,
        "initialSleepLevel": -20
      }
    }
  ],
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/me"
    },
    {
      "method": "GET",
      "host": "app-api",
      "path": "/v1/users/u1/temperature"
    }
  ]
}
