{
  "program": "eightctl",
  "args": [
    "tracks",
    "--output",
    "json"
  ],
  "exit": 0,
  "stdout_json": [
    {
      "id": "t1",
      "title": "Ocean",
      "type": "soundscape"
    },
    {
      "id": "t2",
      "title": "Rain",
      "type": "soundscape"
    }
  ],
  "requests": [
    {
      "method": "POST",
