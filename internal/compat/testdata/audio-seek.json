{
  "program": "eightctl",
  "args": [
    "audio",
    "seek",
    "--position",
    "5000"
  ],
  "exit": 0,
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/me"
    },
    {
      "method": "POST",
      "host": "client-api",
      "path": "/v1/users/u1/audio/player/seek"
    }
  ],
  "writes": [
    {
      "method": "POST",
      "host": "client-api",
      "path": "/v1/users/u1/audio/player/seek",
      "body": {
        "position": 5000
      }
    }
  ]
}
