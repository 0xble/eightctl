{
  "program": "eightctl",
  "args": [
    "audio",
    "favorites",
    "remove",
    "--track",
    "t1"
  ],
  "exit": 0,
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/me"
    },
    {
      "method": "DELETE",
      "host": "client-api",
      "path": "/v1/users/u1/audio/tracks/favorites/t1"
    }
  ],
  "writes": [
    {
      "method": "DELETE",
      "host": "client-api",
      "path": "/v1/users/u1/audio/tracks/favorites/t1"
    }
  ]
}
