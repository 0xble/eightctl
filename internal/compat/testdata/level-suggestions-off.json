{
  "program": "eightctl",
  "args": [
    "autopilot",
    "level-suggestions",
    "--enabled=false"
  ],
  "exit": 0,
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/me"
    },
    {
      "method": "PUT",
      "host": "client-api",
      "path": "/v1/users/u1/level-suggestions-mode"
    }
  ]
}
