{
  "program": "eightctl",
  "args": [
    "travel",
    "create-plan",
    "--trip",
    "trip1",
    "--name",
    "Adjust"
  ],
  "exit": 0,
  "requests": [
    {
      "method": "POST",
      "host": "auth-api",
      "path": "/v1/tokens"
    },
    {
      "method": "GET",
      "host": "client-api",
      "path": "/v1/users/me"
    },
    {
      "method": "POST",
      "host": "client-api",
      "path": "/v1/users/u1/travel/trips/trip1/plans"
    }
  ],
  "writes": [
    {
      "method": "POST",
      "host": "client-api",
      "path": "/v1/users/u1/travel/trips/trip1/plans",
      "body": {
        "name": "Adjust"
      }
    }
  ]
}
