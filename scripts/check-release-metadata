#!/bin/sh
set -eu

if [ "$#" -gt 1 ]; then
  echo "usage: $0 [release-version]" >&2
  exit 2
fi
requested_version=${1#v}

package_version=$(awk -F '"' '$2 == "version" { print $4; exit }' package.json)
changelog_version=$(awk '/^## [0-9]+\.[0-9]+\.[0-9]+( |$)/ { print $2; exit }' CHANGELOG.md)

if [ -z "$package_version" ] || [ -z "$changelog_version" ]; then
	echo "could not resolve release metadata from package.json and CHANGELOG.md" >&2
	exit 1
fi

package_release_version=$(printf '%s\n' "$package_version" | sed 's/-0xble\.[0-9A-Za-z.-]*$//')
if [ "$package_release_version" != "$changelog_version" ]; then
  echo "package.json release base $package_release_version does not match latest finalized changelog version $changelog_version" >&2
  exit 1
fi
if [ -n "$requested_version" ] && [ "$requested_version" != "$package_release_version" ]; then
  echo "requested release version $requested_version does not match repository release base $package_release_version" >&2
  exit 1
fi

echo "release metadata matches v$package_release_version"
